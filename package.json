{
  "name": "nodestro-app-ui",
  "version": "0.1.0",
  "private": true,
  "description": "The standard web interface of exported Nodestro apps: plain files, no build step, no runtime dependencies.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "manifest": "node scripts/manifest.mjs --write",
    "manifest:check": "node scripts/manifest.mjs --check",
    "test": "node --test \"test/unit/*.test.mjs\"",
    "e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.mjs\"",
    "build": "node scripts/build-artifact.mjs",
    "build:standalone": "node scripts/build-standalone.mjs"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "playwright": "1.63.0"
  }
}
